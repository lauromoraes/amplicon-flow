{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AmpliconFlow experiment parameters",
  "type": "object",
  "required": [
    "experiment_name",
    "base_dir",
    "inputs",
    "pipeline"
  ],
  "properties": {
    "experiment_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {"enum": [".", ".."]}
    },
    "base_dir": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "required": [
        "metadata_file"
      ],
      "properties": {
        "metadata_file": {
          "type": "string",
          "minLength": 1
        },
        "manifest_file": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "demultiplexed_sequences": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "min_free_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "sequencing": {
      "type": "object",
      "properties": {
        "read_layout": {"enum": ["single-end", "paired-end"]}
      },
      "additionalProperties": true
    },
    "prepare_data": {
      "type": "object",
      "required": ["phred_offset", "quality_plot_reads"],
      "properties": {
        "phred_offset": {"const": 33},
        "quality_plot_reads": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "prepare-data",
              "quality-control",
              "rarefaction-analysis",
              "metataxonomy",
              "diversity-analysis",
              "abundance-analysis",
              "lefse-analysis",
              "picrust2-analysis",
              "ancombc2-analysis",
              "report"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pipeline": {
            "properties": {
              "steps": {"contains": {"const": "prepare-data"}}
            },
            "required": ["steps"]
          }
        },
        "required": ["pipeline"]
      },
      "then": {
        "required": ["sequencing", "prepare_data"],
        "properties": {
          "inputs": {"required": ["manifest_file"]},
          "sequencing": {"required": ["read_layout"]}
        }
      }
    }
  ],
  "additionalProperties": true
}
