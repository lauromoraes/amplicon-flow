#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -lt 2 ]]; then
    echo "Usage: ampliconflow <parameters.yaml> <conda-environment> [--run-id ID]" >&2
    exit 1
fi
PARAMETERS_FILE="$1"
CONDA_ENV="$2"
shift 2
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONDA_BASE="${CONDA_BASE:-/opt/miniconda}"
CONDA_SH="${CONDA_BASE}/etc/profile.d/conda.sh"
[[ -f "$PARAMETERS_FILE" ]] || { echo "Error: parameter file not found: $PARAMETERS_FILE" >&2; exit 1; }
[[ -f "$CONDA_SH" ]] || { echo "Error: Conda initialization file not found: $CONDA_SH" >&2; exit 1; }
source "$CONDA_SH"
conda activate "$CONDA_ENV"
export PYTHONPATH="${PROJECT_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec python -m ampliconflow.runner "$PARAMETERS_FILE" --project-dir "$PROJECT_DIR" "$@"
